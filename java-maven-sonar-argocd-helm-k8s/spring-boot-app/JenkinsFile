pipeline {
  agent {
    docker {
      image 'abhishekf5/maven-docker-agent:v2'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
    }
  }

  stages {

    stage('Checkout') {
  steps {
    git branch: 'main',
        url: 'https://github.com/ankit012345/Jenkins-Zero-To-Hero.git'
  }
}

    stage('Build and Test') {
      steps {
        sh 'ls -ltr'

        // Build the project and create a JAR file
        sh '''
          cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
          mvn clean package
        '''
      }
    }

    stage('Static Code Analysis') {
      environment {
        SONAR_URL = 'http://3.109.209.161:9000'
      }

      steps {
        withCredentials([
          string(
            credentialsId: 'sonarqube-token',
            variable: 'SONAR_AUTH_TOKEN'
          )
        ]) {
          sh '''
            cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
              -Dsonar.login=$SONAR_AUTH_TOKEN \
              -Dsonar.host.url=$SONAR_URL
          '''
        }
      }
    }

  stage('Build and Push Docker Image') {
  environment {
    DOCKER_IMAGE = "ankit012345/ultimate-cicd:${BUILD_NUMBER}"
    REGISTRY_CREDENTIALS = credentials('docker-cred')
  }

  steps {
    script {
      sh '''
        cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
        docker build -t ${DOCKER_IMAGE} .
      '''

      def dockerImage = docker.image("${DOCKER_IMAGE}")

      docker.withRegistry(
        'https://index.docker.io/v1/',
        'docker-cred'
      ) {
        dockerImage.push()
      }
    }
  }
}
  stage('Update Deployment File') {
  environment {
    GIT_REPO_NAME = 'Jenkins-Zero-To-Hero'
    GIT_USER_NAME = 'ankit012345'
  }

  steps {
    withCredentials([
      string(
        credentialsId: 'github',
        variable: 'GITHUB_TOKEN'
      )
    ]) {
    sh '''
      echo "WORKSPACE=$WORKSPACE"
      pwd
      ls -la
      ls -la .git || true
      git rev-parse --is-inside-work-tree
      git remote -v
    '''
    }
  }
}
}
}
